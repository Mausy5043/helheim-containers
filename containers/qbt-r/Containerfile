###############################
# Stage 1 — Build environment #
###############################
FROM debian:stable AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# versions to build
ARG LIBTORRENT_VERSION=2.0.11
ARG QBITTORRENT_VERSION=5.1.4

# Base tools
RUN apt-get update && \
    apt-get install -yqq locales && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen
RUN apt-get install -yqq --no-install-recommends \
        apt-utils && \
    apt-get install -yqq --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        git \
        tree \
        nano \
        ca-certificates \
        python3 \
        zlib1g-dev \
        libssl-dev \
        libboost-all-dev \
        qt6-base-dev \
        qt6-base-private-dev \
        qt6-tools-dev \
        qt6-tools-private-dev \
        qt6-svg-dev \
        libqt5xmlpatterns5-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

###############################
# Build libtorrent            #
###############################

RUN git -c advice.detachedHead=false clone --branch v${LIBTORRENT_VERSION} https://github.com/arvidn/libtorrent.git && \
    cd libtorrent && \
    git submodule update --init --recursive && \
    cmake -B build \
          -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          -Wno-dev && \
    cmake --build build -j$(nproc) && \
    cmake --install build

###############################
# Build qBittorrent           #
###############################

RUN git -c advice.detachedHead=false clone --branch release-${QBITTORRENT_VERSION} --depth=1 https://github.com/qbittorrent/qBittorrent.git && \
    cd qBittorrent && \
    cmake -B build \
          -DCMAKE_BUILD_TYPE=Release \
          -DGUI=OFF \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          -Wno-dev && \
    cmake --build build -j$(nproc) && \
    cmake --install build

################################
# Stage 2 — Runtime environment #
################################
FROM debian:stable

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Runtime dependencies only
RUN apt-get update && \
    apt-get install -yqq \
        locales && \
    echo "en_US.UTF-8 UTF-8" > /etc/locale.gen && \
    locale-gen
RUN apt-get install -yqq --no-install-recommends \
        apt-utils && \
    apt-get install -yqq --no-install-recommends \
        tree \
        nano \
        ca-certificates \
        python3 \
        python3-pip \
        libssl3 \
        zlib1g \
        libboost-system1.83.0 \
        libboost-chrono1.83.0 \
        libboost-random1.83.0 \
        libboost-serialization1.83.0 \
        qt6-base-dev-tools \
        libqt6core6 \
        libqt6network6 \
        libqt6xml6 \
        libqt6sql6 \
        libqt6sql6-sqlite \
        libqt6concurrent6 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy artifacts from builder
COPY --from=builder /usr/local /usr/local

# Ensure dynamic linker can find libtorrent
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/usr-local-lib.conf && \
    ldconfig

# Create runtime directories
RUN mkdir -p /qbt-r/config /qbt-r/downloads /qbt-r/incomplete /qbt-r/monitor

EXPOSE 1340/tcp

ENTRYPOINT ["/usr/local/bin/qbittorrent-nox", "--profile=/qbt-r/config", "--webui-port=1340"]
