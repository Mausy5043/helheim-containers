FROM archlinux:latest

USER root
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install Octave dependencies
RUN pacman -Syu --noconfirm  && \
    pacman -S --noconfirm --needed \
        curl \
        ca-certificates \
        nano \
        python \
        python-pip \
        tree

RUN pacman -S --noconfirm --needed \
        octave \
        octave-doc \
        octave-statistics

RUN pacman -Scc --noconfirm

# Create group and user with fixed UID/GID
RUN groupadd -g 500 octave
RUN useradd -m -u 500 -g 500 -o -s /bin/bash octave

USER octave
WORKDIR /home/octave
ENV PS1="(octave) \\u@\\h:\\w\\$ "

# Entrypoint to start Octave
ENTRYPOINT ["/bin/bash"]
