FROM archlinux:latest

USER root
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install Octave dependencies
RUN pacman -Syu --noconfirm  && \
    pacman -S --noconfirm --needed \
        base-devel \
        pcre mercurial gcc-fortran gperf perl \
        rsync transfig arpack curl rapidjson fftw fltk glpk glu graphicsmagick \
        qt6-base qt6-tools hdf5 java-environment qhull qscintilla-qt6 \
        texinfo gnuplot llvm texlive-bin icoutils gl2ps qrupdate \
        curl \
        ca-certificates \
        nano \
        python \
        python-pip \
        tree

RUN pacman -S --noconfirm --needed \
        octave \
        yay \

RUN yay -S units

RUN pacman -Scc --noconfirm

# Create group and user with fixed UID/GID
RUN groupadd -g 500 octave
RUN useradd -m -u 500 -g 500 -o -s /bin/bash octave

USER octave
WORKDIR /home/octave

COPY --from=scripts pkg_install.m /home/octave/pkg_install.m
RUN /usr/bin/octave /home/octave/pkg_install.m

ENV PS1="(octave) \\u@\\h:\\w\\$ "

# Entrypoint to start Octave
ENTRYPOINT ["/bin/bash"]
