# This service is for periodically collecting the electricity data

[Unit]
Description=collecting electricity data (service)
Wants=lektrix-collect6.timer
Wants=network-online.target
After=network-online.target

[Service]
# Excecute the hourly trending script inside a rootless Podman container
ExecStartPre=/usr/bin/podman rm -f lektrix_collect6
ExecStart=/usr/bin/podman --log-level=error run \
    --name lektrix_collect6 \
    --rm \
    --volume /etc/localtime:/etc/localtime:ro \
    --volume /srv/containers/lektrix/config:/app/config:ro \
    --volume /srv/containers/lektrix/data:/app/data:rw \
    --volume /home/beheer/git/lektrix/bin:/app/scripts:ro \
    --volume /srv/containers/lektrix/www:/app/www:rw \
    lektrix_collect6:helheim \
    /app/scripts/collect6.sh
Restart=no


Type=simple
TimeoutStartSec=270
TimeoutStopSec=30
# StandardOutput=journal
# StandardError=journal
StandardOutput=null
StandardError=null
